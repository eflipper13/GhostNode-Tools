# Safe local defaults. Never put RPC credentials in this file.
GHOSTNODE_CLI_PATH=ghost-cli
GHOSTNODE_DATADIR=~/.ghost
GHOSTNODE_SERVICE=ghost.service
GHOSTNODE_INTELLIGENCE_DB=./data/staking_intelligence.sqlite3
GHOSTNODE_DASHBOARD_MODE=localhost
GHOSTNODE_DASHBOARD_LAN_ADDRESS=
GHOSTNODE_DASHBOARD_PORT=44678
# Required only for localhost_lan; keep the token outside the repository.
GHOSTNODE_DASHBOARD_TOKEN_FILE=
GHOSTNODE_NETWORK_CONFIG=~/.config/ghostnode-tools/network.json
